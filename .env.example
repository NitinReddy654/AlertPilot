ALERTPILOT_ENV=development
ALERTPILOT_DB_PATH=data/alertpilot.db
ALERTPILOT_TOKEN_SECRET=replace-with-a-long-random-secret
ALERTPILOT_TOKEN_TTL_SECONDS=3600
ALERTPILOT_BOOTSTRAP_EMAIL=admin@alertpilot.local
ALERTPILOT_BOOTSTRAP_PASSWORD=changeme
ALERTPILOT_LOG_LEVEL=INFO
ALERTPILOT_ENABLE_REDIS=1
ALERTPILOT_REDIS_URL=redis://localhost:6379/0
ALERTPILOT_RATE_LIMIT_PER_MINUTE=100
ALERTPILOT_RATE_LIMIT_WINDOW_SECONDS=60
ALERTPILOT_FINGERPRINT_CACHE_TTL_SECONDS=60
ALERTPILOT_ENABLE_KAFKA=0
ALERTPILOT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ALERTPILOT_KAFKA_TOPIC=incident.created
ALERTPILOT_KAFKA_CONSUMER_GROUP=alertpilot-notifications
MLFLOW_TRACKING_URI=./.mlflow
